# ─── OFFLINE (local PostgreSQL) ───────────────────────────────────────────────
# Set DATABASE_URL to use the local database.
# Remove or comment it out to switch to the online Neon database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/placementjava

# SMTP Configuration (For Forgot Password OTP)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Default Admin Email (For Admin Password Reset)
ADMIN_EMAIL=admin@college.edu

# ─── ONLINE (Neon cloud PostgreSQL) ───────────────────────────────────────────
# Used automatically when DATABASE_URL is not set.
# DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DB_USER=your_db_user
DB_PASSWORD=your_db_password
